<div class="section-label"><span class="bar"></span> TOOLS</div>

<div class="tabs">
  <div class="tab active" data-cat="all">☰ ALL</div>
  <div class="tab" data-cat="game"><i data-lucide="gamepad-2"></i> MINI GAME</div>
</div>

<div class="grid" id="grid">
  <% tools.game.forEach(item => { %>
    <div class="card game" data-cat="game" data-open="<%= item.open %>">
      <div class="card-icon"><%- item.icon %></div>
      <div class="card-name"><%= item.name %></div>
      <div class="card-sub"><%= item.sub %></div>
      <div class="badge new"><%= item.badge %></div>
      <div class="card-arrow">→</div>
    </div>
  <% }) %>
</div>